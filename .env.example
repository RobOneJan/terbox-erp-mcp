TERBOX_API_BASE_URL=https://api.example.com
TERBOX_API_KEY=your-api-key-here
# Optional, defaults shown
TERBOX_API_TIMEOUT=60
TERBOX_DOWNLOAD_DIR=./downloads

# Odoo (saas~19.4+, JSON-2 API). Use a dedicated Odoo user with minimal rights.
# Odoo caps API key lifetime at 3 months - rotate before expiry.
ODOO_URL=https://your-db.odoo.com
ODOO_API_KEY=your-odoo-api-key
ODOO_DB=your-db
# Optional, default shown
ODOO_API_TIMEOUT=25
# Optional: keep pending approvals across restarts (mounted volume in production)
# APPROVAL_STORE_DIR=./var/approvals
